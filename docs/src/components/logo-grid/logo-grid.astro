---
import type { SvgComponent } from 'astro/types';

interface Props {
	title: string;
}

const svgs = import.meta.glob<SvgComponent>('./logos/*.svg', { eager: true, import: 'default' });

const logos = {
	// e.g. https://openai.github.io/openai-agents-js/
	openai: { label: 'OpenAI', h: 48 },
	// e.g. https://github.github.com/gh-aw/
	github: { label: 'GitHub', h: 40 },
	// e.g. https://docs.netlify.com/
	netlify: { label: 'Netlify', h: 80 },
	// e.g. https://microsoft.github.io/genaiscript/, https://azure.github.io/typespec-azure/, https://aspire.dev/
	microsoft: { label: 'Microsoft', h: 50 },
	// e.g. https://developers.wpengine.com/docs/
	wpengine: { label: 'WP Engine', h: 45 },
	// e.g. https://warden.sentry.dev/guide, https://spotlightjs.com/docs/getting-started/
	sentry: { label: 'Sentry', h: 42 },
	// e.g. https://luau.org/
	roblox: { label: 'Roblox', h: 33 },
	// e.g. https://docs.warp.dev/
	warp: { label: 'Warp', h: 42 },
	// e.g. https://system76.com/tech-docs/
	system76: { label: 'System76', h: 58 },
	// e.g. https://resources.frame.work/
	framework: { label: 'Framework', h: 35 },
	// e.g. https://tutorialkit.dev/
	stackblitz: { label: 'StackBlitz', h: 44 },
	// e.g. https://support.crowdin.com/
	crowdin: { label: 'Crowdin', h: 48 },
	// e.g. https://stratakit.bentley.com/docs/
	bentley: { label: 'Bentley', h: 36 },
	// e.g. https://zulip.com/help/
	zulip: { label: 'Zulip', h: 40 },
	// e.g. https://docs.honeybadger.io/
	honeybadger: { label: 'Honeybadger', h: 50 },
	// e.g. https://contribute.freecodecamp.org/
	freecodecamp: { label: 'freeCodeCamp', h: 34 },
	// e.g. https://biomejs.dev/
	biome: { label: 'Biome', h: 40 },
	// e.g. https://knip.dev/
	knip: { label: 'Knip', h: 38 },
	// e.g. https://bomb.sh/
	bombshell: { label: 'Bombshell', h: 45 },
};

const maxHeight = Math.max(...Object.values(logos).map(({ h }) => h));
---

<div class="logo-grid-wrapper not-content" data-pagefind-ignore>
	<h2 class="logo-grid-title">{Astro.props.title}</h2>
	<ul role="list" class="logo-grid" style={{ '--max-logo-height': maxHeight }}>
		{
			Object.entries(logos).map(([key, { label, h }]) => {
				const Logo = svgs[`./logos/${key}.svg`];
				if (!Logo) {
					throw new Error(
						`${key}.svg not found. Make sure the file exists in the logos directory.`
					);
				}
				return (
					<li class="sl-flex">
						<Logo aria-hidden="true" style={{ '--h': h }} height={h} />
						<span class="sr-only">{label}</span>
					</li>
				);
			})
		}
	</ul>
</div>

<style>
	.logo-grid-wrapper {
		margin-block: 5rem;
	}
	.logo-grid-title {
		text-align: center;
		font-size: var(--sl-text-h4);
		font-weight: 600;
		color: var(--sl-color-white);
		line-height: var(--sl-line-height-headings);
	}

	.logo-grid {
		/* Row height, matches the tallest logo height. */
		--row-h: var(--max-logo-height);
		/* Scaling factor for logo heights and other dimensions. */
		--scale: 0.36;
		/* Vertical gap between rows. */
		--row-gap: calc(1rem * var(--scale));
		/* The maximum number of rows to display. */
		--max-rows: 7;

		/* Reset default user-agent list styles. */
		list-style: none;
		padding-inline: 0;

		margin-top: calc(3rem * var(--scale));

		/* Lay out logos in a centred flex container */
		display: flex;
		gap: var(--row-gap) calc(3rem * var(--scale));
		justify-content: center;
		flex-wrap: wrap;

		/** Constrain the maximum height of the logo grid. */
		--max-h: calc(var(--max-rows) * (var(--row-h) * var(--scale) * 1px + var(--row-gap)));
		max-height: var(--max-h);
		overflow: clip;
		/* Fade out lower rows to hint that there are more logos when some are cut off. */
		mask-image: linear-gradient(#fff, #fff 33%, #fff0);
		mask-size: 100% var(--max-h);
	}
	:global([data-theme='light']) .logo-grid {
		color: var(--sl-color-gray-3);
	}

	.logo-grid :global(svg) {
		height: calc(var(--h, 50) * var(--scale) * 1px);
		/* Add margin to top and bottom of logos to make up the space to the row height. This keeps each
    row in the grid of an equal height, giving a smoother vertical rhythm. */
		margin-block: calc((var(--row-h, 80) - var(--h, 50)) * var(--scale) * 1px / 2);
		width: auto;
	}

	@media (min-width: 30rem) {
		.logo-grid {
			--scale: 0.45;
			--max-rows: 100;
		}
	}
	@media (min-width: 50rem) {
		.logo-grid {
			--scale: 0.55;
		}
	}
</style>
