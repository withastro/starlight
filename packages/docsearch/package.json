{
  "name": "@astrojs/starlight-docsearch",
  "version": "0.7.0",
  "description": "Algolia DocSearch plugin for the Starlight documentation theme for Astro",
  "scripts": {
    "build": "tsdown"
  },
  "author": "Chris Swithinbank <swithinbank@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withastro/starlight.git",
    "directory": "packages/docsearch"
  },
  "bugs": "https://github.com/withastro/starlight/issues",
  "homepage": "https://starlight.astro.build",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./DocSearch.astro": "./src/DocSearch.astro",
    "./schema": "./src/schema.ts"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.38.0",
    "astro": "^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@docsearch/css": "^3.6.0",
    "@docsearch/js": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "workspace:*",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./DocSearch.astro": "./dist/DocSearch.astro",
      "./schema": {
        "types": "./dist/schema.d.ts",
        "import": "./dist/schema.js"
      }
    }
  }
}
