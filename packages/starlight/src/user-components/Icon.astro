---
import { Icons, type StarlightIcon } from '../components-internals/Icons';

interface Props {
	name: StarlightIcon;
	label?: string;
	color?: string;
	size?: string;
	class?: string;
}

const { name, label, size = '1em', color } = Astro.props;
const a11yAttrs = label ? ({ 'aria-label': label } as const) : ({ 'aria-hidden': 'true' } as const);
---

<svg
	{...a11yAttrs}
	class:list={['sl-icon', Astro.props.class]}
	style={{ '--sl-icon-color': color, '--sl-icon-size': size }}
	width="16"
	height="16"
	viewBox="0 0 24 24"
	fill="currentColor"
	set:html={Icons[name]}
/>
